// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum SessionType {
  PRACTICE
  QUALIFYING
  SPRINT_SHOOTOUT
  SPRINT
  RACE
}

enum UserRole {
  ADMIN
  USER
}

model Circuit {
  id         Int     @id @default(autoincrement())
  circuitRef String  @unique
  name       String
  location   String
  country    String
  latitude   Float
  longitude  Float
  altitude   Int?
  url        String?

  races Race[]
}

model F1Constructor {
  id             Int     @id @default(autoincrement())
  constructorRef String  @unique
  name           String
  nationality    String
  url            String?

  teamSeasons DriverTeamSeason[]
  results     SessionResult[]

  @@map("Constructor")
}

model Driver {
  id          Int      @id @default(autoincrement())
  driverRef   String   @unique
  code        String?
  firstName   String
  lastName    String
  nationality String
  dateOfBirth DateTime
  url         String?

  teamSeasons DriverTeamSeason[]
  results     SessionResult[]
}

model DriverTeamSeason {
  id            Int @id @default(autoincrement())
  driverId      Int
  seasonId      Int
  constructorId Int

  driver      Driver        @relation(fields: [driverId], references: [id])
  season      Season        @relation(fields: [seasonId], references: [id])
  constructor F1Constructor @relation(fields: [constructorId], references: [id])

  @@unique([driverId, seasonId, constructorId])
}

model IngestionJob {
  id               Int                @id @default(autoincrement())
  initYear         Int
  lastYear         Int?
  status           IngestionJobStatus @default(QUEUED)
  totalSeasons     Int
  processedSeasons Int                @default(0)
  failedSeasons    Int                @default(0)
  currentYear      Int?
  errors           Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Race {
  id        Int       @id @default(autoincrement())
  seasonId  Int
  round     Int
  circuitId Int
  name      String
  date      DateTime
  time      DateTime?
  url       String?

  circuit  Circuit       @relation(fields: [circuitId], references: [id])
  season   Season        @relation(fields: [seasonId], references: [id])
  sessions RaceSession[]

  @@unique([seasonId, round])
}

model RaceSession {
  id            Int         @id @default(autoincrement())
  raceId        Int
  type          SessionType
  sessionNumber Int         @default(1)
  date          DateTime?
  time          DateTime?

  race    Race            @relation(fields: [raceId], references: [id])
  results SessionResult[]

  @@unique([raceId, type, sessionNumber])
}

model Season {
  id   Int     @id @default(autoincrement())
  year Int     @unique
  url  String?
  isComplete Boolean @default(false)

  driverTeamSeasons DriverTeamSeason[]
  races             Race[]
}

model SessionResult {
  id            Int @id @default(autoincrement())
  raceSessionId Int
  driverId      Int
  constructorId Int

  number   Int?
  position Int?
  grid     Int?
  points   Float?
  laps     Int?
  status   String?

  fastestLap     Int?
  fastestLapRank Int?
  fastestLapTime String?

  q1 String?
  q2 String?
  q3 String?

  raceSession RaceSession   @relation(fields: [raceSessionId], references: [id])
  driver      Driver        @relation(fields: [driverId], references: [id])
  constructor F1Constructor @relation(fields: [constructorId], references: [id])

  @@unique([raceSessionId, driverId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
